{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>dszakallas/renovate-config//default.json5",
    "docker:enableMajor",
    ":automergeBranch",
    ":skipStatusChecks",
  ],

  schedule: ["* 6-12 1,15 * *"],
  timezone: "Europe/Prague",
  labels: ["dep", "autofix"],

  nix: {
    enabled: true,
  },
  npm: {
    enabled: true,
    managerFilePatterns: ["/(^|/)package\\.json$/"],
  },
  gomod: {
    enabled: true,
  },
  customManagers: [
    {
      customType: "regex",
      description: "Update vendored manifests version in VendorKustomization files",
      managerFilePatterns: ["/(^|/)k8s(/.+)?/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\n\\s*version:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
    },
  ],
  packageRules: [
    {
      description: "Do not update container images inside upstream vendored manifests",
      matchFileNames: ["**/*.vendored.yaml", "**/vendor/**"],
      matchManagers: ["kubernetes"],
      enabled: false,
    },
    {
      description: ["Auto-merge patch updates"],
      automerge: true,
      matchUpdateTypes: ["patch"],
      addLabels: ["automerge"],
    },
    {
      description: ["Auto-merge GitHub Actions for minor and patch"],
      matchManagers: ["github-actions"],
      matchDatasources: ["github-tags"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      addLabels: ["automerge"],
    },
    {
      matchManagers: ["gomod"],
      semanticCommitScope: "deps",
      addLabels: ["dep/source:go"],
    },
    {
      matchManagers: ["npm"],
      semanticCommitScope: "deps",
      addLabels: ["dep/source:npm"],
    },
    {
      matchManagers: ["nix"],
      semanticCommitScope: "nix",
      addLabels: ["dep/source:nix"],
    },
    {
      matchDatasources: ["github-releases"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(vendor)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "vendor",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "vendor",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
  ],
}

